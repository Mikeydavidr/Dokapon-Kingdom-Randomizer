  "baked_buildings": {
    "_": "Buildings that are not placed by a matrix. They are clusters of welded vertices (vertices that share a position) in a batch mesh, in WORLD coordinates (raw = world), so a building is moved by adding the same offset to all of its vertices. Select them with: every welded cluster of the mesh whose centre is within `radius` of `centre`. Verified in the running game (lift by 60).",
    "2": {
      "kind": "magic store",
      "file": "N",
      "mesh": 59,
      "centre": [
        -580,
        155
      ],
      "radius": 18,
      "note": "radius 11 leaves the steps' neighbours; 18 also takes the purple mushrooms around it"
    },
    "123": {
      "kind": "castle",
      "file": "M",
      "mesh": 5,
      "centre": [
        372,
        240
      ],
      "radius": 25
    },
    "199": {
      "kind": "castle",
      "file": "M",
      "mesh": 2,
      "centre": [
        547,
        -372
      ],
      "radius": 25
    },
    "260": {
      "kind": "castle",
      "file": "M",
      "mesh": 43,
      "centre": [
        -79,
        -483
      ],
      "radius": 30,
      "note": "the palm trees around it are matrices A47/A60, which are also its shadow"
    }
  },
